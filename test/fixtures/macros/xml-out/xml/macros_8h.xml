        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Flush pending work.</para>
<para><simplesect kind="note"><para>Flushing is best effort. </para>
</simplesect>
<simplesect kind="remark"><para>Callers usually prefer <ref refid="macros_8h_1a8168e46e61860b969b9ee6c101bbc1c9" kindref="member">drain()</ref>. </para>
</simplesect>
<simplesect kind="warning"><para>Blocks until the queue is empty. </para>
</simplesect>
<simplesect kind="attention"><para>Never call this from a signal handler.</para>
</simplesect>
<xrefsect id="deprecated_1_deprecated000001"><xreftitle>Deprecated</xreftitle><xrefdescription><para>Use <ref refid="macros_8h_1a8168e46e61860b969b9ee6c101bbc1c9" kindref="member">drain()</ref> instead. </para>
</xrefdescription></xrefsect></para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="src/macros.h" line="39" column="6" declfile="src/macros.h" declline="39" declcolumn="6"/>
      </memberdef>
      <memberdef kind="function" id="macros_8h_1a8168e46e61860b969b9ee6c101bbc1c9" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>void drain</definition>
        <argsstring>(void)</argsstring>
        <name>drain</name>
        <param>
          <type>void</type>
        </param>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Drain the queue.</para>
<para>Ordering rules:</para>
<para><itemizedlist>
<listitem><para>first<itemizedlist>
<listitem><para>first.a</para>
</listitem><listitem><para>first.b</para>
</listitem></itemizedlist>
</para>
</listitem><listitem><para>second<itemizedlist>
<listitem><para>second.a</para>
</listitem></itemizedlist>
</para>
</listitem><listitem><para>third</para>
</listitem></itemizedlist>
</para>
<para>Steps:</para>
<para><orderedlist>
<listitem><para>open<orderedlist>
<listitem><para>acquire</para>
</listitem><listitem><para>verify</para>
</listitem></orderedlist>
</para>
</listitem><listitem><para>close</para>
</listitem></orderedlist>
</para>
<para>Terms:</para>
<para><variablelist>
<varlistentry><term>pending</term></varlistentry>
<listitem><para>queued but not started </para>
</listitem>
<varlistentry><term>settled</term></varlistentry>
<listitem><para>finished either way </para>
</listitem>
</variablelist>
</para>
<para>Caveats:</para>
<para><itemizedlist>
<listitem><para>the queue may grow while draining <simplesect kind="note"><para>callers should not rely on the count</para>
</simplesect>
</para>
</listitem><listitem><para>draining twice is safe </para>
</listitem></itemizedlist>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="src/macros.h" line="73" column="6" declfile="src/macros.h" declline="73" declcolumn="6"/>
      </memberdef>
